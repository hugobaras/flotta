  "narrative": {
    "northStar": "Le Registre de Garage",
    "overview": "Flotta plays the category standard straight for B2B SaaS: cool neutral greys, a single indigo accent, system UI type, tabular numerals, Lucide icons. It is light only, because the office is daylit and drivers work outdoors. Two registers share one set of tokens: a dense calm operator shell and a thumb-sized driver page. State is never carried by color alone.",
    "keyCharacteristics": [
      "Cool grey page, white surfaces, hairline borders; depth is mostly borders, not shadows.",
      "One accent (indigo) for primary action, focus, current navigation and selection.",
      "Semantic trio (green, amber, red), each as text on a tinted fill, always with icon plus label.",
      "System font stack at modest sizes; weights 550 to 650 do the hierarchy work.",
      "Tabular numerals on tables and plates.",
      "No dark mode."
    ],
    "rules": [
      { "name": "The One Indigo Rule", "body": "Indigo means \"act here\" or \"you are here\". It never encodes status.", "section": "colors" },
      { "name": "The Never Color Alone Rule", "body": "A state is color plus icon plus text; the badge and alert components enforce it.", "section": "colors" },
      { "name": "The Tabular Rule", "body": "Tables, counts, times and plates use tabular numerals.", "section": "typography" },
      { "name": "The Flat Until Floating Rule", "body": "Only dialogs get the overlay shadow; everything else is border-defined.", "section": "elevation" }
    ],
    "dos": [
      "Do pair every state color with a Lucide icon and a text label.",
      "Do keep indigo for actions, focus and current location only.",
      "Do use tabular numerals for figures and plates.",
      "Do size driver controls to at least 52px with 1.5px borders and 17px text.",
      "Do keep light mode only.",
      "Do use the system stack and Lucide icons at 14, 16, 18 or 20-22px."
    ],
    "donts": [
      "Don't signal status with color alone.",
      "Don't add a second accent hue or use semantic colors decoratively.",
      "Don't put shadows on anything but panels, secondary buttons, the submit bar and dialogs.",
      "Don't hide table columns off-screen on phones; use the card layout.",
      "Don't load a webfont or add a dark theme."
    ]
  }
